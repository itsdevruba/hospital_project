<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="projecthospital.controllers.LoginController"
          alignment="CENTER" hgap="10" vgap="10" style="-fx-background-color: #f0f0f0;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Title -->
    <Label text="Hospital Appointment System" GridPane.columnIndex="0" GridPane.rowIndex="0"
           GridPane.columnSpan="2" style="-fx-font-size: 24px; -fx-font-weight: bold;">
        <GridPane.margin>
            <Insets bottom="30"/>
        </GridPane.margin>
    </Label>

    <!-- Login Label -->
    <Label text="Login" GridPane.columnIndex="0" GridPane.rowIndex="1"
           GridPane.columnSpan="2" style="-fx-font-size: 18px; -fx-font-weight: bold;">
        <GridPane.margin>
            <Insets bottom="20"/>
        </GridPane.margin>
    </Label>

    <!-- Username -->
    <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <TextField fx:id="txtUsername" GridPane.columnIndex="1" GridPane.rowIndex="2"
               promptText="Enter username" prefWidth="200"/>

    <!-- Password -->
    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <PasswordField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="3"
                   promptText="Enter password" prefWidth="200"/>

    <!-- Role Selection -->
    <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <ComboBox fx:id="cmbRole" GridPane.columnIndex="1" GridPane.rowIndex="4"
              promptText="Select role" prefWidth="200"/>

    <!-- Error Label -->
    <Label fx:id="lblError" GridPane.columnIndex="0" GridPane.rowIndex="5"
           GridPane.columnSpan="2" style="-fx-text-fill: red;"
           wrapText="true"/>

    <!-- Login Button -->
    <Button fx:id="btnLogin" text="Login" GridPane.columnIndex="0" GridPane.rowIndex="6"
            GridPane.columnSpan="2" onAction="#handleLogin"
            prefWidth="150" style="-fx-font-size: 14px;">
        <GridPane.margin>
            <Insets top="20"/>
        </GridPane.margin>
    </Button>

</GridPane>
