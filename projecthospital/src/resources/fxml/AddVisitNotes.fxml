<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="projecthospital.controllers.AddVisitNotesController"
          prefHeight="500" prefWidth="600" alignment="CENTER" hgap="10" vgap="15"
          style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Title -->
    <Label text="Add Visit Notes" GridPane.columnIndex="0" GridPane.rowIndex="0"
           GridPane.columnSpan="2" style="-fx-font-size: 20px; -fx-font-weight: bold;">
        <GridPane.margin>
            <Insets bottom="20"/>
        </GridPane.margin>
    </Label>

    <!-- Patient Info -->
    <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="lblPatientInfo" text="Patient Name" GridPane.columnIndex="1" GridPane.rowIndex="1"
           style="-fx-font-weight: bold;"/>

    <!-- Appointment Info -->
    <Label text="Appointment:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <Label fx:id="lblAppointmentInfo" text="Date and Time" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <!-- Notes -->
    <Label text="Notes:" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.valignment="TOP">
        <GridPane.margin>
            <Insets top="5"/>
        </GridPane.margin>
    </Label>
    <TextArea fx:id="txtNotes" GridPane.columnIndex="1" GridPane.rowIndex="3"
              promptText="Enter visit notes..." prefHeight="100" prefWidth="350" wrapText="true"/>

    <!-- Diagnosis -->
    <Label text="Diagnosis:" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP">
        <GridPane.margin>
            <Insets top="5"/>
        </GridPane.margin>
    </Label>
    <TextArea fx:id="txtDiagnosis" GridPane.columnIndex="1" GridPane.rowIndex="4"
              promptText="Enter diagnosis..." prefHeight="80" prefWidth="350" wrapText="true"/>

    <!-- Prescription -->
    <Label text="Prescription:" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.valignment="TOP">
        <GridPane.margin>
            <Insets top="5"/>
        </GridPane.margin>
    </Label>
    <TextArea fx:id="txtPrescription" GridPane.columnIndex="1" GridPane.rowIndex="5"
              promptText="Enter prescription..." prefHeight="80" prefWidth="350" wrapText="true"/>

    <!-- Message Label -->
    <Label fx:id="lblMessage" GridPane.columnIndex="0" GridPane.rowIndex="6"
           GridPane.columnSpan="2" wrapText="true"/>

    <!-- Buttons -->
    <HBox GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2"
          spacing="10" alignment="CENTER">
        <GridPane.margin>
            <Insets top="20"/>
        </GridPane.margin>
        <Button fx:id="btnSave" text="Save Notes" onAction="#handleSave"
                prefWidth="120" style="-fx-font-size: 14px;"/>
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel"
                prefWidth="120" style="-fx-font-size: 14px;"/>
    </HBox>

</GridPane>
