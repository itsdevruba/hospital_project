<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="projecthospital.controllers.AdminDashboardController"
            prefHeight="550" prefWidth="600" style="-fx-background-color: #f5f5f5;">

    <!-- Top - Header -->
    <top>
        <VBox style="-fx-background-color: #7B1FA2; -fx-padding: 20;">
            <Label fx:id="lblWelcome" text="Welcome, Administrator"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Admin Dashboard"
                   style="-fx-text-fill: white; -fx-font-size: 14px;">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- Center - Navigation Buttons -->
    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="40" right="50" bottom="40" left="50"/>
            </padding>

            <Button fx:id="btnManagePatients" text="Manage Patients" onAction="#handleManagePatients"
                    prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>

            <Button fx:id="btnManageDoctors" text="Manage Doctors" onAction="#handleManageDoctors"
                    prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>

            <Button fx:id="btnViewAppointments" text="View All Appointments" onAction="#handleViewAppointments"
                    prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>

            <Button fx:id="btnSystemReports" text="System Reports" onAction="#handleSystemReports"
                    prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>

            <Button fx:id="btnLogout" text="Logout" onAction="#handleLogout"
                    prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>
        </VBox>
    </center>

</BorderPane>
