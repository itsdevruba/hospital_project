<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecthospital.controllers.BrowseDoctorsController"
      prefHeight="600" prefWidth="700" spacing="10" style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title -->
    <Label text="Browse Doctors" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Doctors Table -->
    <TableView fx:id="tblDoctors" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDoctorId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colDoctorName" text="Doctor Name" prefWidth="200"/>
            <TableColumn fx:id="colSpecialization" text="Specialization" prefWidth="200"/>
            <TableColumn fx:id="colExperience" text="Experience (Years)" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnBookAppointment" text="Book Appointment" onAction="#handleBookAppointment"
                prefWidth="150" style="-fx-font-size: 14px;"/>
        <Button fx:id="btnBack" text="Back to Dashboard" onAction="#handleBack"
                prefWidth="150" style="-fx-font-size: 14px;"/>
    </HBox>

</VBox>
