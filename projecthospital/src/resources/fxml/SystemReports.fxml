<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="projecthospital.controllers.SystemReportsController"
          prefHeight="500" prefWidth="600" alignment="CENTER" hgap="20" vgap="20"
          style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Label text="System Reports" GridPane.columnIndex="0" GridPane.rowIndex="0"
           GridPane.columnSpan="2" style="-fx-font-size: 24px; -fx-font-weight: bold;">
        <GridPane.margin>
            <Insets bottom="30"/>
        </GridPane.margin>
    </Label>

    <!-- Total Patients -->
    <Label text="Total Patients:" GridPane.columnIndex="0" GridPane.rowIndex="1"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblTotalPatients" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>

    <!-- Total Doctors -->
    <Label text="Total Doctors:" GridPane.columnIndex="0" GridPane.rowIndex="2"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblTotalDoctors" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>

    <!-- Total Appointments -->
    <Label text="Total Appointments:" GridPane.columnIndex="0" GridPane.rowIndex="3"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblTotalAppointments" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>

    <!-- Scheduled Appointments -->
    <Label text="Scheduled Appointments:" GridPane.columnIndex="0" GridPane.rowIndex="4"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblScheduledAppointments" text="0" GridPane.columnIndex="1" GridPane.rowIndex="4"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #009688;"/>

    <!-- Completed Appointments -->
    <Label text="Completed Appointments:" GridPane.columnIndex="0" GridPane.rowIndex="5"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblCompletedAppointments" text="0" GridPane.columnIndex="1" GridPane.rowIndex="5"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8BC34A;"/>

    <!-- Cancelled Appointments -->
    <Label text="Cancelled Appointments:" GridPane.columnIndex="0" GridPane.rowIndex="6"
           style="-fx-font-size: 16px;"/>
    <Label fx:id="lblCancelledAppointments" text="0" GridPane.columnIndex="1" GridPane.rowIndex="6"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F44336;"/>

    <!-- Buttons -->
    <HBox GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2"
          spacing="10" alignment="CENTER">
        <GridPane.margin>
            <Insets top="30"/>
        </GridPane.margin>
        <Button fx:id="btnRefresh" text="Refresh Data" onAction="#handleRefresh"
                prefWidth="150" style="-fx-font-size: 14px;"/>
        <Button fx:id="btnBack" text="Back to Dashboard" onAction="#handleBack"
                prefWidth="150" style="-fx-font-size: 14px;"/>
    </HBox>

</GridPane>
