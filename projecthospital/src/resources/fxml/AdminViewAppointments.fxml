<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecthospital.controllers.AdminViewAppointmentsController"
      prefHeight="600" prefWidth="900" spacing="10" style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title -->
    <Label text="All Appointments" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Search/Filter -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search Patient:"/>
        <TextField fx:id="txtSearchPatient" promptText="Patient name" prefWidth="200"/>
        <Label text="Filter by Status:"/>
        <ComboBox fx:id="cmbStatusFilter" promptText="All" prefWidth="150"/>
        <Button fx:id="btnSearch" text="Search/Filter" onAction="#handleSearch"/>
        <Button fx:id="btnRefresh" text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <!-- Appointments Table -->
    <TableView fx:id="tblAppointments" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAppointmentId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colPatient" text="Patient" prefWidth="200"/>
            <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="200"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colTime" text="Time" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnBack" text="Back to Dashboard" onAction="#handleBack"
                prefWidth="150" style="-fx-font-size: 14px;"/>
    </HBox>

</VBox>
